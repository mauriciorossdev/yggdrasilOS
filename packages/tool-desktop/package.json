{
  "name": "@yggdrasil/tool-desktop",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Desktop automation tools for Yggdrasil agents: open apps, screenshots, notifications — bridged into the app-desktop Electron main process over the loopback pane-control server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@yggdrasil/sdk": "workspace:*",
    "@yggdrasil/tools-sdk": "workspace:*"
  },
  "files": [
    "dist",
    "yggdrasil.plugin.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauriciorossdev/yggdrasilOS.git",
    "directory": "packages/tool-desktop"
  }
}
