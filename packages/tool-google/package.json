{
  "name": "@yggdrasil/tool-google",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Google Calendar/Gmail connector — OAuth (gateway-initiated-by-phone flow) + gcal_list_events/gcal_create_event/gmail_search/gmail_read tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@yggdrasil/config": "workspace:*",
    "@yggdrasil/kernel": "workspace:*",
    "@yggdrasil/sdk": "workspace:*",
    "@yggdrasil/tool-documents": "workspace:*",
    "@yggdrasil/tools-sdk": "workspace:*"
  },
  "files": [
    "dist",
    "yggdrasil.plugin.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauriciorossdev/yggdrasilOS.git",
    "directory": "packages/tool-google"
  }
}
