{
  "name": "@yggdrasil/tool-office",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Office documents for Yggdrasil agents: spreadsheets (.xlsx) that open in the app's workspace and that an agent can read and edit live",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@yggdrasil/sdk": "workspace:*",
    "@yggdrasil/tools-sdk": "workspace:*",
    "docx": "^9.15.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1"
  },
  "files": [
    "dist",
    "yggdrasil.plugin.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauriciorossdev/yggdrasilOS.git",
    "directory": "packages/tool-office"
  },
  "devDependencies": {
    "mammoth": "^1.13.0",
    "officeparser": "^8.9.0"
  }
}
