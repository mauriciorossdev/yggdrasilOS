# Copy to deploy/.env. Never commit that file.

# Required. Generate it with: openssl rand -hex 32
YGGDRASIL_API_KEY=

# docker-compose.yml: the domain pointing at this server.
# DOMAIN=gateway.your-domain.com

# docker-compose.cloudflare.yml: the token of your Cloudflare Tunnel.
# TUNNEL_TOKEN=

# Optional: the cloud assistant (see deploy/README.md).
# ANTHROPIC_API_KEY=
# REPLICATE_API_TOKEN=
# FCM_SERVICE_ACCOUNT_JSON=

# Optional: keep a hand-edited yggdrasil.config.json on the volume.
# YGGDRASIL_KEEP_CONFIG=1
