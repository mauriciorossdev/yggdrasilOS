# Copy to deploy/.env. Never commit that file.

# Required. Generate it with: openssl rand -hex 32
YGGDRASIL_API_KEY=

# Image version to run: the desktop app's version (e.g. 0.2.0). Unset means latest.
# YGGDRASIL_VERSION=

# docker-compose.yml: the domain pointing at this server.
# DOMAIN=gateway.your-domain.com

# docker-compose.cloudflare.yml: the token of your Cloudflare Tunnel.
# TUNNEL_TOKEN=

# Optional: the cloud assistant (see deploy/README.md).
# ANTHROPIC_API_KEY=
# REPLICATE_API_TOKEN=
# FCM_SERVICE_ACCOUNT_JSON=
# Optional: the assistant's provider and model (default: anthropic + Claude Haiku).
# ASSISTANT_PROVIDER=anthropic        # anthropic | openai-compat | ollama
# ASSISTANT_MODEL=claude-haiku-4-5-20251001
# ASSISTANT_BASE_URL=                 # e.g. https://ollama.com/v1 with openai-compat
# OPENAI_API_KEY=                    # only sent to OpenAI
# OLLAMA_API_KEY=                    # only sent to ollama.com
# YGGDRASIL_OPENAI_API_KEY=          # for any other openai-compat URL

# Optional: keep a hand-edited yggdrasil.config.json on the volume.
# YGGDRASIL_KEEP_CONFIG=1
