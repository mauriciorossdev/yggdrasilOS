{
  "agents": [
    {
      "id": "default",
      "label": "Default Agent",
      "provider": "openai-compat",
      "model": "your-model-here",
      "contextProviders": ["prompt-files", "project-context"]
    }
  ],
  "defaultAgent": "default",
  "harness": {
    "policy": "pinned",
    "pinnedId": "llm",
    "streaming": true
  },
  "gateway": {
    "port": 18789,
    "host": "127.0.0.1"
  },
  "providers": {
    "openai-compat": {
      "baseUrl": "http://localhost:11434/v1",
      "defaultModel": "your-model-here"
    }
  },
  "sessions": {
    "maxMessages": 50,
    "compactThreshold": 40,
    "compactionPolicy": "summarize",
    "maxTokens": 12000
  },
  "plugins": {
    "load": {
      "paths": ["extensions"]
    },
    "discoverNodeModules": true,
    "installed": [],
    "disabled": []
  },
  "pluginConfig": {
    "context-prompt-files": {
      "paths": ["prompts"]
    }
  },
  "context": {
    "defaultProviders": ["prompt-files", "project-context"],
    "tokenBudget": 4000
  },
  "auth": {
    "gateway": {
      "apiKeys": [
        { "key": "replace-with-openssl-rand-hex-32", "name": "admin" },
        { "key": "replace-with-another-key", "name": "tester-1", "expiresAt": 9999999999999 }
      ]
    }
  },
  "channels": {
    "tui": { "enabled": true },
    "http": {
      "enabled": true,
      "accounts": {
        "default": { "port": 18790 }
      }
    },
    "telegram": { "enabled": false },
    "echo": { "enabled": false }
  }
}
