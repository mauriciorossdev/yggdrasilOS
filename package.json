{
  "name": "yggdrasil",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Plug-and-play agent platform — the world tree spine for channels, harnesses, and providers",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run --exclude 'test/e2e/live/**'",
    "test:watch": "vitest --exclude 'test/e2e/live/**'",
    "test:unit": "vitest run packages extensions",
    "test:coverage": "vitest run --exclude 'test/e2e/live/**' --coverage",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:all": "pnpm test && pnpm test:live",
    "typecheck": "pnpm -r run typecheck",
    "yggdrasil": "node packages/cli/dist/index.js",
    "desktop": "pnpm --filter @yggdrasil/app-desktop dev",
    "desktop:watch": "pnpm --filter @yggdrasil/app-desktop dev --watch",
    "desktop:build": "pnpm --filter @yggdrasil/app-desktop dist",
    "avatar": "pnpm --filter @yggdrasil/app-avatar dev"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}
