  },
  "client": [
    {
      "client_info": {
        "mobilesdk_app_id": "<your-android-app-id>",
        "android_client_info": { "package_name": "<your-application-id>" }
      },
      "oauth_client": [],
      "api_key": [{ "current_key": "<your-firebase-api-key>" }],
      "services": {}
    }
  ],
  "configuration_version": "1"
}
